<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup/device-transfer rules. The secure-storage file is
     excluded for the same reason as in backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage"/>
    </device-transfer>
</data-extraction-rules>
